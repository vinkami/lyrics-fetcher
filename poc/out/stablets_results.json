{
 "01 アンデッド": {
  "align_secs": 6.1,
  "n_lines": 27,
  "n_segments": 1,
  "monotonic_violations": 0,
  "lines_over_2s_vs_current": 7,
  "rows": [
   {
    "line": 0,
    "text": "利口さで渡れ 橋の途中まで見える",
    "cur": 0.0,
    "stable": 14.3,
    "delta": 14.3
   },
   {
    "line": 1,
    "text": "行けるなら行こう",
    "cur": 9.38,
    "stable": 19.28,
    "delta": 9.9
   },
   {
    "line": 2,
    "text": "行けないやつらも見てきたから",
    "cur": 18.76,
    "stable": 21.44,
    "delta": 2.68
   },
   {
    "line": 3,
    "text": "騙し騙されて当たり前なのは何なの",
    "cur": 24.0,
    "stable": 24.24,
    "delta": 0.24
   },
   {
    "line": 4,
    "text": "善性を否定するならばどっか他所へ行っちまえよ",
    "cur": 29.0,
    "stable": 29.22,
    "delta": 0.22
   },
   {
    "line": 5,
    "text": "血相デッドロックな急行 厭世感",
    "cur": 34.0,
    "stable": 34.22,
    "delta": 0.22
   },
   {
    "line": 6,
    "text": "ずっと忘却 どっかに取っておいた一欠片",
    "cur": 39.0,
    "stable": 39.14,
    "delta": 0.14
   },
   {
    "line": 7,
    "text": "ずっと綺麗なもの 変わらぬまま色褪せはしないから",
    "cur": 44.0,
    "stable": 43.86,
    "delta": -0.14
   },
   {
    "line": 8,
    "text": "只々生きているの くたばる日まで",
    "cur": 49.2,
    "stable": 49.46,
    "delta": 0.26
   },
   {
    "line": 9,
    "text": "願った未来じゃなくてもきっと走ってるさ",
    "cur": 54.82,
    "stable": 53.9,
    "delta": -0.92
   },
   {
    "line": 10,
    "text": "根拠なんてない説明もしない 遠くに残響",
    "cur": 58.16,
    "stable": 58.9,
    "delta": 0.74
   },
   {
    "line": 11,
    "text": "遠くに見えている事故現場みたいな様相",
    "cur": 73.84,
    "stable": 64.06,
    "delta": -9.78
   },
   {
    "line": 12,
    "text": "野次馬が爆発いずれ骨だけが残るのさ",
    "cur": 78.84,
    "stable": 78.92,
    "delta": 0.08
   },
   {
    "line": 13,
    "text": "温くなる水に口を付けるのも忘れ",
    "cur": 84.18,
    "stable": 83.9,
    "delta": -0.28
   },
   {
    "line": 14,
    "text": "憑かれたみたい まるで我を無くした生命体",
    "cur": 88.9,
    "stable": 89.36,
    "delta": 0.46
   },
   {
    "line": 15,
    "text": "薙ぎ払って延期中 今さら",
    "cur": 92.95,
    "stable": 94.52,
    "delta": 1.57
   },
   {
    "line": 16,
    "text": "慰めるようなワード",
    "cur": 97.0,
    "stable": 99.5,
    "delta": 2.5
   },
   {
    "line": 17,
    "text": "感傷 レッカーされた有能 ワンショット",
    "cur": 109.08,
    "stable": 123.84,
    "delta": 14.76
   },
   {
    "line": 18,
    "text": "そんな洗礼 重力忘れたい日曜に",
    "cur": 121.16,
    "stable": 128.66,
    "delta": 7.5
   },
   {
    "line": 19,
    "text": "ずっと正しくはない 変わりもなく時間に引きつられて",
    "cur": 133.24,
    "stable": 133.38,
    "delta": 0.14
   },
   {
    "line": 20,
    "text": "狂いそうなほど思うのは何のせいなの",
    "cur": 138.0,
    "stable": 139.12,
    "delta": 1.12
   },
   {
    "line": 21,
    "text": "滲んだ努力の傷跡なんて意味はないが",
    "cur": 142.0,
    "stable": 143.46,
    "delta": 1.46
   },
   {
    "line": 22,
    "text": "謙虚さにすら錆が付くなら 燃やせ感傷",
    "cur": 147.0,
    "stable": 148.42,
    "delta": 1.42
   },
   {
    "line": 23,
    "text": "ずっと綺麗なもの 変わらぬまま色褪せはしないから",
    "cur": 152.0,
