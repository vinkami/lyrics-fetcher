    "delta": -0.09
   },
   {
    "line": 2,
    "text": "何辺やって言ったの",
    "cur": 4.67,
    "stable": 4.98,
    "delta": 0.31
   },
   {
    "line": 3,
    "text": "無駄を怖れている現代病",
    "cur": 6.5,
    "stable": 6.48,
    "delta": -0.02
   },
   {
    "line": 4,
    "text": "挑戦状破ったら近代近世の撤退戦",
    "cur": 14.33,
    "stable": 8.92,
    "delta": -5.41
   },
   {
    "line": 5,
    "text": "何辺やって言ったの 正体現してみやがれ",
    "cur": 22.17,
    "stable": 12.92,
    "delta": -9.25
   },
   {
    "line": 6,
    "text": "足元から来る何かを払うように",
    "cur": 30.0,
    "stable": 33.28,
    "delta": 3.28
   },
   {
    "line": 7,
    "text": "異次元みたいに 比べてもしょうが無い事",
    "cur": 36.0,
    "stable": 36.94,
    "delta": 0.94
   },
   {
    "line": 8,
    "text": "救いなんて無い？ それを思うこと自体",
    "cur": 40.0,
    "stable": 40.9,
    "delta": 0.9
   },
   {
    "line": 9,
    "text": "惨めに思えてきそうだろう 嫌になるよ",
    "cur": 43.0,
    "stable": 43.98,
    "delta": 0.98
   },
   {
    "line": 10,
    "text": "愛の無い言葉 掲げるのは誰",
    "cur": 46.0,
    "stable": 47.74,
    "delta": 1.74
   },
   {
    "line": 11,
    "text": "楽なままで居たいんでしょ 膠着",
    "cur": 51.0,
    "stable": 51.8,
    "delta": 0.8
   },
   {
    "line": 12,
    "text": "前頭葉はデッドなう 生存匂わせカット",
    "cur": 54.5,
    "stable": 56.54,
    "delta": 2.04
   },
   {
    "line": 13,
    "text": "尊大ぶった闇魔帳",
    "cur": 58.0,
    "stable": 60.5,
    "delta": 2.5
   },
   {
    "line": 14,
    "text": "なぁなぁのままです中途半端",
    "cur": 61.5,
    "stable": 62.24,
    "delta": 0.74
   },
   {
    "line": 15,
    "text": "現実妙なファンタジー 環状線あっちで乗った",
    "cur": 65.0,
    "stable": 64.48,
    "delta": -0.52
   },
   {
    "line": 16,
    "text": "情勢なんて聞いてない どこもかしこも真っ暗",
    "cur": 68.5,
    "stable": 68.44,
    "delta": -0.06
   },
   {
    "line": 17,
    "text": "正しさだけでは つまらないんだ",
    "cur": 72.0,
    "stable": 72.0,
    "delta": 0.0
   },
   {
    "line": 18,
    "text": "今日も正論で叩く 遠いところから安全に",
    "cur": 75.0,
    "stable": 75.34,
    "delta": 0.34
   },
   {
    "line": 19,
    "text": "リアルのない今 この画面に映ってる疑惑が",
    "cur": 79.0,
    "stable": 80.58,
    "delta": 1.58
   },
   {
    "line": 20,
    "text": "こんな新しいルールなのは変じゃない？",
    "cur": 84.0,
    "stable": 85.04,
    "delta": 1.04
   },
   {
    "line": 21,
    "text": "天才なら憂鬱 凡人には平穏",
    "cur": 92.0,
    "stable": 96.98,
    "delta": 4.98
   },
   {
    "line": 22,
    "text": "待っても変わらなくて 何か物悲しい",
    "cur": 100.0,
    "stable": 100.38,
    "delta": 0.38
   },
   {
    "line": 23,
    "text": "苛立ちのロールプレイ あやふやなレベリングだ",
    "cur": 104.0,
    "stable": 104.38,
    "delta": 0.38
   },
   {
    "line": 24,
    "text": "憔悴したホームの果て 分断して達成だ",
    "cur": 108.0,
    "stable": 108.34,
    "delta": 0.34
   },
   {
    "line": 25,
    "text": "信じられる事など数えるほどしかないまま",
    "cur": 112.0,
    "stable": 112.3,
    "delta": 0.3
   },
   {
    "line": 26,
    "text": "零れ落ちたファズが鳴いて世界が燃える 嗚呼",
    "cur": 126.0,
    "stable": 115.96,
    "delta": -10.04
   },
   {
    "line": 27,
    "text": "生存だってエンドゲーム",
    "cur": 140.0,
    "stable": 123.86,
    "delta": -16.14
   },
   {
    "line": 28,
    "text": "諦観やってんのがジョーク",
    "cur": 154.0,
    "stable": 138.84,
    "delta": -15.16
   },
   {
    "line": 29,
    "text": "ヒーローだってさいなら",
    "cur": 168.0,
    "stable": 139.34,
    "delta": -28.66
   },
   {
    "line": 30,
    "text": "青春時代の中 乱反射",
    "cur": 182.0,
    "stable": 142.7,
    "delta": -39.3
   },
   {
    "line": 31,
    "text": "グッバイそんなファンタジー",
    "cur": 183.67,
    "stable": 142.7,
    "delta": -40.97
   },
   {
    "line": 32,
    "text": "勿体ぶってんのは何だ",
    "cur": 185.33,
    "stable": 143.34,
    "delta": -41.99
   },
   {
    "line": 33,
    "text": "人間そんなもんだろうって",
    "cur": 187.0,
    "stable": 143.34,
    "delta": -43.66
   },
   {
    "line": 34,
    "text": "取ってつけたように歌う",
    "cur": 190.0,
    "stable": 143.44,
    "delta": -46.56
   },
   {
    "line": 35,
    "text": "恐れぬものだけが残れ",
    "cur": 192.0,
    "stable": 144.06,
    "delta": -47.94
   },
   {
    "line": 36,
    "text": "その命を振り回せよ",
    "cur": 194.0,
    "stable": 164.16,
    "delta": -29.84
   },
   {
    "line": 37,
    "text": "生きているなら",
    "cur": 206.0,
    "stable": 175.3,
    "delta": -30.7
   }
  ]
 },
