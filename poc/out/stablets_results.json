 "02 命を振り回せ": {
  "align_secs": 35.6,
  "n_lines": 38,
  "n_segments": 1,
  "monotonic_violations": 0,
  "lines_over_2s_vs_current": 18,
  "rows": [
   {
    "line": 0,
    "text": "後悔だってエンドロール",
    "cur": 1.0,
    "stable": 0.96,
    "delta": -0.04
   },
   {
    "line": 1,
    "text": "どうやって言っても、そうさ",
    "cur": 2.83,
